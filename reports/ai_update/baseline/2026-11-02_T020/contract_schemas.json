{
  "AnalyzeRequest": {
    "$defs": {
      "CommentIn": {
        "properties": {
          "comment_id": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Comment Id",
            "type": "string"
          },
          "user_id": {
            "description": "Pseudonymous ID, not a real username",
            "maxLength": 120,
            "minLength": 1,
            "title": "User Id",
            "type": "string"
          },
          "text": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent Id"
          },
          "mentioned_user_ids": {
            "description": "Optional platform-resolved user IDs; not annotated labels",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Mentioned User Ids",
            "type": "array"
          }
        },
        "required": [
          "comment_id",
          "user_id",
          "text",
          "timestamp"
        ],
        "title": "CommentIn",
        "type": "object"
      }
    },
    "properties": {
      "thread_id": {
        "maxLength": 120,
        "minLength": 1,
        "title": "Thread Id",
        "type": "string"
      },
      "comments": {
        "items": {
          "$ref": "#/$defs/CommentIn"
        },
        "maxItems": 500,
        "minItems": 1,
        "title": "Comments",
        "type": "array"
      },
      "profile": {
        "default": "conservative",
        "enum": [
          "conservative",
          "research_synthetic"
        ],
        "title": "Profile",
        "type": "string"
      }
    },
    "required": [
      "thread_id",
      "comments"
    ],
    "title": "AnalyzeRequest",
    "type": "object"
  },
  "AnalyzeResponse": {
    "$defs": {
      "CommentOut": {
        "properties": {
          "comment_id": {
            "title": "Comment Id",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "toxicity_score": {
            "title": "Toxicity Score",
            "type": "number"
          },
          "toxic_for_moderation": {
            "title": "Toxic For Moderation",
            "type": "boolean"
          },
          "toxic_for_repeated_rule": {
            "title": "Toxic For Repeated Rule",
            "type": "boolean"
          },
          "target_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target User Id"
          },
          "target_method": {
            "title": "Target Method",
            "type": "string"
          },
          "target_confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "none"
            ],
            "title": "Target Confidence",
            "type": "string"
          },
          "profanity_detected": {
            "default": false,
            "title": "Profanity Detected",
            "type": "boolean"
          },
          "lexical_review_recommended": {
            "default": false,
            "title": "Lexical Review Recommended",
            "type": "boolean"
          },
          "directed_insult_candidate": {
            "default": false,
            "title": "Directed Insult Candidate",
            "type": "boolean"
          },
          "reported_or_apology_context": {
            "default": false,
            "title": "Reported Or Apology Context",
            "type": "boolean"
          },
          "review_recommended": {
            "default": false,
            "title": "Review Recommended",
            "type": "boolean"
          },
          "lexical_signals": {
            "items": {
              "$ref": "#/$defs/LexicalSignalOut"
            },
            "title": "Lexical Signals",
            "type": "array"
          }
        },
        "required": [
          "comment_id",
          "user_id",
          "parent_id",
          "timestamp",
          "toxicity_score",
          "toxic_for_moderation",
          "toxic_for_repeated_rule",
          "target_user_id",
          "target_method",
          "target_confidence"
        ],
        "title": "CommentOut",
        "type": "object"
      },
      "EvidenceOut": {
        "properties": {
          "actor_user_id": {
            "title": "Actor User Id",
            "type": "string"
          },
          "target_user_id": {
            "title": "Target User Id",
            "type": "string"
          },
          "evidence_comment_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Comment Ids",
            "type": "array"
          },
          "n_distinct_timestamps": {
            "title": "N Distinct Timestamps",
            "type": "integer"
          },
          "target_confidence": {
            "title": "Target Confidence",
            "type": "string"
          }
        },
        "required": [
          "actor_user_id",
          "target_user_id",
          "evidence_comment_ids",
          "n_distinct_timestamps",
          "target_confidence"
        ],
        "title": "EvidenceOut",
        "type": "object"
      },
      "LexicalSignalOut": {
        "properties": {
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "matched_form": {
            "title": "Matched Form",
            "type": "string"
          },
          "strength": {
            "title": "Strength",
            "type": "string"
          },
          "canonical_form": {
            "default": "",
            "title": "Canonical Form",
            "type": "string"
          },
          "language": {
            "default": "",
            "title": "Language",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          },
          "start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End"
          }
        },
        "required": [
          "rule_id",
          "category",
          "matched_form",
          "strength"
        ],
        "title": "LexicalSignalOut",
        "type": "object"
      }
    },
    "properties": {
      "thread_id": {
        "title": "Thread Id",
        "type": "string"
      },
      "model_name": {
        "title": "Model Name",
        "type": "string"
      },
      "model_threshold": {
        "title": "Model Threshold",
        "type": "number"
      },
      "repeated_rule_threshold": {
        "title": "Repeated Rule Threshold",
        "type": "number"
      },
      "profile": {
        "title": "Profile",
        "type": "string"
      },
      "research_only": {
        "title": "Research Only",
        "type": "boolean"
      },
      "suspected_repeated_harassment": {
        "title": "Suspected Repeated Harassment",
        "type": "boolean"
      },
      "risk_level": {
        "enum": [
          "none",
          "needs_review",
          "suspected_repeated"
        ],
        "title": "Risk Level",
        "type": "string"
      },
      "risk_score_heuristic": {
        "title": "Risk Score Heuristic",
        "type": "integer"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/EvidenceOut"
        },
        "title": "Evidence",
        "type": "array"
      },
      "comments": {
        "items": {
          "$ref": "#/$defs/CommentOut"
        },
        "title": "Comments",
        "type": "array"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "thread_id",
      "model_name",
      "model_threshold",
      "repeated_rule_threshold",
      "profile",
      "research_only",
      "suspected_repeated_harassment",
      "risk_level",
      "risk_score_heuristic",
      "evidence",
      "comments",
      "warnings"
    ],
    "title": "AnalyzeResponse",
    "type": "object"
  },
  "ModerationRequest": {
    "$defs": {
      "ContextComment": {
        "additionalProperties": false,
        "properties": {
          "comment_id": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9:_-]+$",
            "title": "Comment Id",
            "type": "string"
          },
          "user_id": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9:_-]+$",
            "title": "User Id",
            "type": "string"
          },
          "text": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9:_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent Id"
          },
          "mentioned_user_ids": {
            "items": {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            "maxItems": 5,
            "title": "Mentioned User Ids",
            "type": "array"
          }
        },
        "required": [
          "comment_id",
          "user_id",
          "text",
          "timestamp"
        ],
        "title": "ContextComment",
        "type": "object"
      },
      "ModerationContext": {
        "additionalProperties": false,
        "properties": {
          "post_id": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9:_-]+$",
            "title": "Post Id",
            "type": "string"
          },
          "source": {
            "const": "social-api",
            "default": "social-api",
            "title": "Source",
            "type": "string"
          },
          "complete": {
            "default": false,
            "title": "Complete",
            "type": "boolean"
          },
          "recent_comments": {
            "items": {
              "$ref": "#/$defs/ContextComment"
            },
            "maxItems": 50,
            "title": "Recent Comments",
            "type": "array"
          }
        },
        "required": [
          "post_id"
        ],
        "title": "ModerationContext",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "request_id": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9:_-]+$",
        "title": "Request Id",
        "type": "string"
      },
      "content_id": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9:_-]+$",
        "title": "Content Id",
        "type": "string"
      },
      "content_type": {
        "default": "comment",
        "enum": [
          "post",
          "comment"
        ],
        "title": "Content Type",
        "type": "string"
      },
      "content_revision": {
        "minimum": 1,
        "title": "Content Revision",
        "type": "integer"
      },
      "user_id": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9:_-]+$",
        "title": "User Id",
        "type": "string"
      },
      "text": {
        "maxLength": 8000,
        "minLength": 1,
        "title": "Text",
        "type": "string"
      },
      "timestamp": {
        "format": "date-time",
        "title": "Timestamp",
        "type": "string"
      },
      "parent_id": {
        "anyOf": [
          {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9:_-]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Parent Id"
      },
      "mentioned_user_ids": {
        "items": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        "maxItems": 5,
        "title": "Mentioned User Ids",
        "type": "array"
      },
      "context": {
        "$ref": "#/$defs/ModerationContext"
      },
      "language_hint": {
        "default": "vi",
        "enum": [
          "vi",
          "en",
          "mixed",
          "unknown"
        ],
        "title": "Language Hint",
        "type": "string"
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "content_id",
      "content_revision",
      "user_id",
      "text",
      "timestamp",
      "context"
    ],
    "title": "ModerationRequest",
    "type": "object"
  },
  "ModerationResponse": {
    "$defs": {
      "LexicalSignal": {
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Rule Id",
            "type": "string"
          },
          "category": {
            "enum": [
              "profanity",
              "directed_insult",
              "ambiguous",
              "other_sensitive"
            ],
            "title": "Category",
            "type": "string"
          },
          "matched_form": {
            "maxLength": 8000,
            "title": "Matched Form",
            "type": "string"
          },
          "strength": {
            "maxLength": 32,
            "title": "Strength",
            "type": "string"
          },
          "canonical_form": {
            "default": "",
            "maxLength": 1000,
            "title": "Canonical Form",
            "type": "string"
          },
          "language": {
            "default": "",
            "maxLength": 32,
            "title": "Language",
            "type": "string"
          },
          "reason": {
            "default": "",
            "maxLength": 3000,
            "title": "Reason",
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "title": "Source Ids",
            "type": "array"
          },
          "start": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End"
          }
        },
        "required": [
          "rule_id",
          "category",
          "matched_form",
          "strength"
        ],
        "title": "LexicalSignal",
        "type": "object"
      },
      "RepeatedEvidence": {
        "additionalProperties": false,
        "properties": {
          "actor_user_id": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9:_-]+$",
            "title": "Actor User Id",
            "type": "string"
          },
          "target_user_id": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9:_-]+$",
            "title": "Target User Id",
            "type": "string"
          },
          "evidence_comment_ids": {
            "items": {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            "maxItems": 51,
            "minItems": 2,
            "title": "Evidence Comment Ids",
            "type": "array"
          },
          "n_distinct_timestamps": {
            "maximum": 51,
            "minimum": 2,
            "title": "N Distinct Timestamps",
            "type": "integer"
          },
          "target_confidence": {
            "enum": [
              "medium",
              "high"
            ],
            "title": "Target Confidence",
            "type": "string"
          }
        },
        "required": [
          "actor_user_id",
          "target_user_id",
          "evidence_comment_ids",
          "n_distinct_timestamps",
          "target_confidence"
        ],
        "title": "RepeatedEvidence",
        "type": "object"
      },
      "TargetEvidence": {
        "additionalProperties": false,
        "properties": {
          "target_user_id": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9:_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target User Id"
          },
          "method": {
            "maxLength": 100,
            "title": "Method",
            "type": "string"
          },
          "confidence": {
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ],
            "title": "Confidence",
            "type": "string"
          }
        },
        "required": [
          "method",
          "confidence"
        ],
        "title": "TargetEvidence",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "request_id": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9:_-]+$",
        "title": "Request Id",
        "type": "string"
      },
      "content_id": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9:_-]+$",
        "title": "Content Id",
        "type": "string"
      },
      "content_revision": {
        "minimum": 1,
        "title": "Content Revision",
        "type": "integer"
      },
      "model_name": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Model Name",
        "type": "string"
      },
      "model_version": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Model Version",
        "type": "string"
      },
      "lexicon_version": {
        "maxLength": 100,
        "minLength": 1,
        "title": "Lexicon Version",
        "type": "string"
      },
      "analyzed_at": {
        "format": "date-time",
        "title": "Analyzed At",
        "type": "string"
      },
      "model_threshold": {
        "const": 0.41,
        "title": "Model Threshold",
        "type": "number"
      },
      "toxicity_score": {
        "maximum": 1,
        "minimum": 0,
        "title": "Toxicity Score",
        "type": "number"
      },
      "ai_label": {
        "enum": [
          "CLEAN",
          "TOXIC"
        ],
        "title": "Ai Label",
        "type": "string"
      },
      "lexical_review_recommended": {
        "title": "Lexical Review Recommended",
        "type": "boolean"
      },
      "directed_insult_candidate": {
        "title": "Directed Insult Candidate",
        "type": "boolean"
      },
      "reported_or_apology_context": {
        "title": "Reported Or Apology Context",
        "type": "boolean"
      },
      "lexical_signals": {
        "items": {
          "$ref": "#/$defs/LexicalSignal"
        },
        "maxItems": 2000,
        "title": "Lexical Signals",
        "type": "array"
      },
      "target_evidence": {
        "$ref": "#/$defs/TargetEvidence"
      },
      "suspected_repeated_harassment": {
        "title": "Suspected Repeated Harassment",
        "type": "boolean"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/RepeatedEvidence"
        },
        "maxItems": 50,
        "title": "Evidence",
        "type": "array"
      },
      "suggested_action": {
        "enum": [
          "approve",
          "needs_review"
        ],
        "title": "Suggested Action",
        "type": "string"
      },
      "decision_authority": {
        "const": "advisory",
        "title": "Decision Authority",
        "type": "string"
      },
      "limitations": {
        "items": {
          "maxLength": 3000,
          "type": "string"
        },
        "maxItems": 30,
        "title": "Limitations",
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "content_id",
      "content_revision",
      "model_name",
      "model_version",
      "lexicon_version",
      "analyzed_at",
      "model_threshold",
      "toxicity_score",
      "ai_label",
      "lexical_review_recommended",
      "directed_insult_candidate",
      "reported_or_apology_context",
      "lexical_signals",
      "target_evidence",
      "suspected_repeated_harassment",
      "evidence",
      "suggested_action",
      "decision_authority",
      "limitations"
    ],
    "title": "ModerationResponse",
    "type": "object"
  }
}
