# Export in shell; no automatic .env loading. Default DB is service/data/social.sqlite3.
SOCIAL_REGISTRATION_ENABLED=false
SOCIAL_SESSION_TTL_SECONDS=3600
SOCIAL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SOCIAL_AUTH_RATE_LIMIT=10
SOCIAL_AUTH_RATE_WINDOW_SECONDS=60
SOCIAL_CONTENT_RATE_LIMIT=30
SOCIAL_CONTENT_RATE_WINDOW_SECONDS=60
# SOCIAL_DATABASE_URL must use an absolute SQLite path, or postgresql+psycopg.
# Worker process only. Export SOCIAL_AI_SERVICE_TOKEN via a secret source, never VITE_*.
SOCIAL_AI_BASE_URL=http://127.0.0.1:8000
SOCIAL_AI_CONNECT_TIMEOUT=3
SOCIAL_AI_READ_TIMEOUT=60
SOCIAL_WORKER_LEASE_SECONDS=180
SOCIAL_WORKER_MAX_ATTEMPTS=3
SOCIAL_WORKER_POLL_SECONDS=2
