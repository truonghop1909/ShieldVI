    },
    "/api/v1/moderate/comment": {
      "post": {
        "tags": [
          "internal-moderation"
        ],
        "summary": "Endpoint",
        "operationId": "endpoint_api_v1_moderate_comment_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModerationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModerationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
