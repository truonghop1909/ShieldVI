{
  "$defs": {
    "ContextComment": {
      "additionalProperties": false,
      "properties": {
        "comment_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Comment Id",
          "type": "string"
        },
        "user_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "User Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "mentioned_user_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9:_-]+$",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Mentioned User Ids",
          "type": "array"
        }
      },
      "required": [
        "comment_id",
        "user_id",
        "text",
        "timestamp"
      ],
      "title": "ContextComment",
      "type": "object"
    },
    "ModerationContext": {
      "additionalProperties": false,
      "properties": {
        "post_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Post Id",
          "type": "string"
        },
        "source": {
          "const": "social-api",
          "default": "social-api",
          "title": "Source",
          "type": "string"
        },
        "complete": {
          "default": false,
          "title": "Complete",
          "type": "boolean"
        },
        "recent_comments": {
          "items": {
            "$ref": "#/$defs/ContextComment"
          },
          "maxItems": 50,
          "title": "Recent Comments",
          "type": "array"
        }
      },
      "required": [
        "post_id"
      ],
      "title": "ModerationContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "content_id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Content Id",
      "type": "string"
    },
    "content_type": {
      "default": "comment",
      "enum": [
        "post",
        "comment"
      ],
      "title": "Content Type",
      "type": "string"
    },
    "content_revision": {
      "minimum": 1,
      "title": "Content Revision",
      "type": "integer"
    },
    "user_id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "User Id",
      "type": "string"
    },
    "text": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "parent_id": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "mentioned_user_ids": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9:_-]+$",
        "type": "string"
      },
      "maxItems": 5,
      "title": "Mentioned User Ids",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/ModerationContext"
    },
    "language_hint": {
      "default": "vi",
      "enum": [
        "vi",
        "en",
        "mixed",
        "unknown"
      ],
      "title": "Language Hint",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "content_id",
    "content_revision",
    "user_id",
    "text",
    "timestamp",
    "context"
  ],
  "title": "ModerationRequest",
  "type": "object"
}
