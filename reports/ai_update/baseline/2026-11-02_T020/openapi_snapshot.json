          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HumanReviewBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
