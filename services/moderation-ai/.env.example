# Backend reads environment, not this file automatically.
# Export AI_SERVICE_TOKEN (at least 32 characters) from your secret source.
AI_SERVICE_RATE_LIMIT=60
# MODEL_PATH may point to an existing checkpoint. Otherwise keep approved auto-selection.
# Explicit DB paths recommended; relative paths are resolved against repository root.
# REVIEW_DB_PATH=/absolute/private/path/research-reviews.sqlite3
# DB_PATH=/absolute/private/path/research-summaries.sqlite3
STORE_SUMMARIES=0
